<%SQL%
DB=Tholos.DefinitionDBIndex;
ROW=tholosbuilder/propframe.property.row;
SQL=
select cp.component_id, cp.name, cp.l_name, cp.type, cp.type_desc, cp.value,
       cp.value_component_id, cp.property_id, cp.link_id, cp.version, cp.mandatory, cp.runtime,
       tp.short_path
  from app_component_properties_v cp
       left outer join (select rid,
                               case when max(top_parent_id) is null then
                                    max(case when lvl = d - 1 then name end) ||
                                    case when d > 2 then '/' || max(case when lvl = d - 2 then name end) end ||
                                    case when d = 4 then '/' || max(case when lvl = 1 then name end)
                                         when d > 4 then '/.../' || max(case when lvl = 1 then name end) end
                               end as short_path
                          from (select connect_by_root(n.id) as rid, level as lvl, n.name,
                                       count(*) over (partition by connect_by_root(n.id)) as d,
                                       case when connect_by_isleaf = 1 then n.parent_id end as top_parent_id
                                  from (select c.id, c.parent_id, cp2.value as name
                                          from app_components c
                                          join app_component_properties cp2 on cp2.component_id = c.id
                                          join def_properties p on p.id = cp2.property_id and lower(p.name) = 'name') n
                                 start with n.id in (select acp.value_component_id
                                                       from app_component_properties acp
                                                      where acp.component_id=$p_component_id~='-1';)
                               connect by prior n.parent_id = n.id)
                         group by rid, d) tp on tp.rid=cp.value_component_id
 where cp.component_id=$p_component_id~='-1';
       and ('$p_property_id~='-1';'='-1' or cp.property_id=$p_property_id~='-1';)
 order by 3
%SQL%>